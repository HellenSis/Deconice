# Deco Nice Boutique - Security & Server Configuration (.htaccess)

# 1. Directorio de Entrada Predeterminado
DirectoryIndex index.html inicio.html index.php

# 2. Deshabilitar Exploración de Directorios
Options -Indexes

# 3. Rewrite Rules - Eliminar extensión .html
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirigir /archivo.html -> /archivo (externo, SEO)
    RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,NE]

    # Reescribir internamente /archivo -> /archivo.html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# 4. Encabezados de Seguridad HTTP (Hardened Security Headers)
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self' https://cdn.tailwindcss.com https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net https://wa.me https://*.googleusercontent.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:;"
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 4. Proteger archivos sensibles y de configuración
<FilesMatch "\.(txt|sql|log|md|git|env|json|bak|config)$">
    Require all denied
</FilesMatch>

# 5. Compresión GZIP para acelerar carga
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
